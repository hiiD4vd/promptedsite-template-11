{
  "name": "promptedsite-template-11",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-runtime.mjs",
    "dev": "vite --host 127.0.0.1 --port 3027",
    "prebuild": "node scripts/build-runtime.mjs",
    "build": "tsc -b && vite build",
    "assets:prepare-preview": "node scripts/prepare-browser-preview.mjs",
    "build:artifact": "npm run assets:prepare-preview && VITE_MEDIA_BASE_URL=/ VITE_ALLOW_SOFTWARE_WEBGL=1 npm run build",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "test": "playwright test",
    "test:gpu": "playwright test --config playwright.gpu.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4178"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
